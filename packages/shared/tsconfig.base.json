{
  // Options common to both output formats. See tsconfig.cjs.json and
  // tsconfig.esm.json for why there are two.
  //
  // rootDir is pinned to ./src so output lands at dist/<fmt>/enums.js rather
  // than dist/<fmt>/src/enums.js — package.json#exports depends on that shape.
  //
  // No "dom" lib and no decorators: this package is consumed by both a Node
  // service and a browser bundle, and must not depend on Nest, class-validator,
  // or anything else from either app.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "rootDir": "./src",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src"]
}
